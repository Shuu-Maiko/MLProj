# ============================================
# Machine-learning artifacts (large binaries)
# ============================================
# Trained model weights — usually too large for git.
# Remove these lines if you intentionally version weights.
backend/artifacts/models/**/*.pt
backend/artifacts/models/**/*.pth
backend/artifacts/models/**/*.ckpt
backend/artifacts/models/**/*.onnx
backend/artifacts/models/**/*.bin
backend/artifacts/models/**/*.safetensors

# LightGBM text models & metadata — small, may be kept.
# Uncomment to ignore if you treat them as build outputs.
# backend/artifacts/models/lgbm/*.txt

# ============================================
# Data (large / reproducible)
# ============================================
# Raw scraped/downloaded data — comment out to commit small samples.
backend/data/raw/**/*.csv
backend/data/raw/**/*.parquet
backend/data/raw/state_15min/

# Processed datasets — regenerable from raw via pipeline.
# backend/data/processed/*.parquet

# ============================================
# Evaluation / run outputs (optional)
# ============================================
# backend/artifacts/results/*.parquet
# backend/artifacts/results/*.json
